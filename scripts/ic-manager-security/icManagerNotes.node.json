{
  "admin": {
    "$icId": {
      ".read": "auth != null && root.child('authSessions').child(auth.uid).child('userUid').val() == 'admin' && root.child('users').child('admin').child('status').val() == 'active'",
      "$date": {
        ".write": "auth != null && root.child('authSessions').child(auth.uid).child('userUid').val() == 'admin' && root.child('users').child('admin').child('status').val() == 'active' && newData.exists()",
        ".validate": "$date.matches(/^([0-9]{4}-(0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|[0-9]{4}-(0[469]|11)-(0[1-9]|[12][0-9]|30)|[0-9]{4}-02-(0[1-9]|1[0-9]|2[0-8])|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)$/) && newData.hasChildren(['version','revision','text','updatedAt','updatedBy'])",
        "version": {".validate": "newData.val() == 1"},
        "revision": {".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() == (data.exists() ? data.val() + 1 : 1)"},
        "text": {".validate": "newData.isString() && newData.val().length <= 12000"},
        "updatedAt": {".validate": "newData.isNumber() && newData.val() <= now + 10000 && newData.val() >= now - 300000"},
        "updatedBy": {".validate": "newData.val() == 'admin'"},
        "$other": {".validate": false}
      }
    }
  }
}
